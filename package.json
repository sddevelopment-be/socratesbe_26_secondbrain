{
  "name": "socratesbe-26-secondbrain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SoCraTes BE 2026 second brain — a docsite for humans and agents, built with DocKitty.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "dockitty-validate-frontmatter docs",
    "links": "dockitty-check-links docs --strict",
    "new": "dockitty-new-doc",
    "lint:md": "markdownlint-cli2",
    "spell": "cspell --no-progress",
    "check:dist": "dockitty-assert-no-broken-links dist --base /socratesbe_26_secondbrain --site https://sddevelopment-be.github.io && node scripts/check-md-views.mjs dist https://sddevelopment-be.github.io/socratesbe_26_secondbrain"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.6",
    "@spec-kitty/doc-toolkit": "github:spec-kitty/doc-kitty#4c0d6beb24eb5ac2bb06d69f829c444cbe5ff99a&path:/src",
    "astro": "^7.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cspell/dict-en-gb": "^5.0.38",
    "cspell": "^10.4.0",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "^5.9.3"
  }
}
