---
/*
 * Out-of-frame deck route. A `kind: Presentation` page under `presentations/`
 * renders here as a full-screen reveal.js deck instead of a Starlight page.
 *
 * The deck does not inherit the theme's customCss, so the SoCraTes palette
 * (tokenCss) and the deck look (deckThemeCss) are passed in explicitly.
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DeckLayout from '@spec-kitty/doc-toolkit/layouts/DeckLayout.astro';
import { deckRouteParams } from '@spec-kitty/doc-toolkit/deck/deck-slug';
import paletteHref from '../../theme/socrates.css?url';
import deckThemeHref from '../../theme/deck.css?url';

export const prerender = true;

export async function getStaticPaths() {
  const decks = (await getCollection('docs')).filter(
    (entry) => entry.data.kind === 'Presentation' && entry.id.startsWith('presentations/'),
  );
  return decks.map((entry) => ({ params: deckRouteParams(entry), props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props as Props;
---

<DeckLayout entry={entry} tokenCss={[paletteHref]} deckThemeCss={[deckThemeHref]} />
