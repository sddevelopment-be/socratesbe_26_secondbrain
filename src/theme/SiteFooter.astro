---
/*
 * SoCraTes BE footer band (dk:site-footer slot). Rendered below Starlight's
 * article footer on every page. A "this page as" row with the page's machine
 * views, three columns like socratesbe.org's footer, and a darker base strip
 * with contact and code of conduct.
 */
import { getCollection } from 'astro:content';
import { slugFromEntryId } from '@spec-kitty/doc-toolkit';
import { viewSlug } from '../lib/page-views';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/sddevelopment-be/socratesbe_26_secondbrain';

// The page being rendered, taken from Starlight's route data rather than the
// URL. Only docs entries have machine views (not the 404 page); viewSlug names
// them as the toolkit's routes do, 'home' for the root. Starlight gives the
// root the id '' where the collection stores it as the toolkit's root id, so
// both sides are compared as route slugs.
const routeId = (Astro.locals as { starlightRoute?: { entry?: { id: string } } }).starlightRoute
  ?.entry?.id;
const entry =
  routeId === undefined
    ? undefined
    : (await getCollection('docs')).find(
        (e) => slugFromEntryId(e.id) === slugFromEntryId(routeId),
      );
const slug = entry ? viewSlug(entry.id) : '';
const views = entry
  ? [
      { label: 'HTML', href: Astro.url.pathname, current: true },
      { label: 'JSON', href: `${base}/${slug}.json` },
      { label: 'YAML', href: `${base}/${slug}.yaml` },
      { label: 'Markdown', href: `${base}/${slug}.md` },
      { label: 'Source', href: `${repo}/blob/main/${entry.filePath}` },
    ]
  : [];

const columns = [
  {
    title: 'Our',
    highlight: 'community',
    links: [
      { label: 'socratesbe.org', href: 'https://socratesbe.org/' },
      { label: 'Slack', href: 'https://socratesbe.org/slack/' },
      { label: 'Meetup', href: 'https://www.meetup.com/socratesbe/' },
      { label: 'GitHub', href: 'https://github.com/socratesbe' },
    ],
  },
  {
    title: 'This',
    highlight: 'second brain',
    links: [
      { label: 'How to contribute', href: `${base}/guides/` },
      { label: 'Source on GitHub', href: repo },
      { label: 'Built with DocKitty', href: 'https://github.com/spec-kitty/doc-kitty' },
    ],
  },
  {
    title: 'For',
    highlight: 'agents',
    links: [
      { label: 'llms.txt', href: `${base}/llms.txt` },
      { label: 'Agent API (JSON)', href: `${base}/api/index.json` },
      { label: 'Content graph', href: `${base}/api/content-graph.json` },
      { label: 'OKF bundle', href: `${base}/okf/index.md` },
      { label: 'RSS feed', href: `${base}/rss.xml` },
      { label: 'Sitemap', href: `${base}/sitemap-index.xml` },
    ],
  },
];
---

<footer class="sb-footer">
  {
    views.length > 0 && (
      <nav class="sb-footer__views" aria-label="This page in other formats">
        <span class="sb-footer__views-label">This page as</span>
        {views.map((view) => (
          <a href={view.href} aria-current={view.current ? 'page' : undefined}>
            {view.label}
          </a>
        ))}
      </nav>
    )
  }
  <div class="sb-footer__cols">
    {
      columns.map((col) => (
        <section class="sb-footer__col">
          <h2 class="sb-footer__title">
            {col.title} <span>{col.highlight}</span>
          </h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <div class="sb-footer__base">
    <span>For software crafters, by software crafters.</span>
    <span>
      <a href="https://confcodeofconduct.com/">Code of conduct</a> ·
      <a href="mailto:info@socratesbe.org">info@socratesbe.org</a> ·
      <a href="#_top">Back to top</a>
    </span>
  </div>
</footer>
